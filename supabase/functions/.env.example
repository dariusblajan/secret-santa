# Local development secrets. Copy to supabase/functions/.env (git-ignored).
ACCESS_CODE=local-dev-code
PUBLIC_APP_URL=http://localhost:5173/
# Print emails to the console instead of sending them through Brevo.
EMAIL_MODE=log
# For real sends locally, remove EMAIL_MODE and set:
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Secret Santa
